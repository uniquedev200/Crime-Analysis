# Vite dev/preview forwards /api to this backend. Restart Vite after changes.
ATLAS_BACKEND_URL=http://127.0.0.1:8000

# Optional: set only when a separately hosted frontend calls another backend.
# Must be the origin only, without /api. This value is public in the built JS.
# Leave blank for the proxy or a frontend served directly by FastAPI.
VITE_API_BASE_URL=
