# ==============================================================================
# ATLAS Criminal Intelligence Environment Configuration
# Copy this file to .env and replace placeholders with your actual credentials.
# ==============================================================================

# General / Runtime
ENVIRONMENT=development
SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_2026

# Supabase / PostgreSQL Database Connection
# If using Supabase Pooler: postgresql://postgres.<ref>:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/atlas_db
SUPABASE_PASSWORD=your_password

# Upstash Vector (Used for RAG & forensic document similarity search)
UPSTASH_URL=https://your-database-id-vector.upstash.io
UPSTASH_TOKEN=your_upstash_rest_token_here

# Local Ollama LLM (Optional offline fallback for copilot / summaries)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Neo4j Graph Database (Optional: falls back to built-in in-memory engine if offline)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# LLM Extraction Pipeline (Groq, OpenAI, Gemini, or Mock)
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# Pipeline Guardrails & Modes
ATLAS_SYNTHETIC_ONLY=false
ATLAS_REQUIRE_TESSERACT=false
SEED_SAMPLE_DATA=false
