{
  "$defs": {
    "Assertion": {
      "description": "Assertion confidence grade for relationships and facts.",
      "enum": [
        "stated",
        "model_inferred",
        "structured_record"
      ],
      "title": "Assertion",
      "type": "string"
    },
    "Origin": {
      "description": "Origin mechanism indicating how text or fact was derived.",
      "enum": [
        "pdf_text",
        "ocr",
        "table_parser",
        "text_file",
        "json_file",
        "model_inferred"
      ],
      "title": "Origin",
      "type": "string"
    },
    "QuoteStatus": {
      "description": "Verification outcome of quoted source text against document units.",
      "enum": [
        "verified",
        "verified_ambiguous_location",
        "unverified"
      ],
      "title": "QuoteStatus",
      "type": "string"
    },
    "RelType": {
      "description": "Relationship categories linking mentions or entities.",
      "enum": [
        "USES_PHONE",
        "USES_DEVICE",
        "OWNS_VEHICLE",
        "HOLDS_ACCOUNT",
        "ASSOCIATED_WITH",
        "EMPLOYED_BY",
        "LOCATED_AT",
        "ALSO_KNOWN_AS",
        "CALLED",
        "TRANSFERRED_TO"
      ],
      "title": "RelType",
      "type": "string"
    },
    "ReviewKind": {
      "description": "Categorized review triggers requiring human reviewer inspection.",
      "enum": [
        "low_trust_identifier",
        "invalid_identifier",
        "identifier_not_found_by_parser",
        "role_inferred",
        "ambiguous_date",
        "contradiction",
        "ambiguous_location",
        "mapping_unconfirmed",
        "tabular_pdf_detected",
        "match_candidate",
        "chunk_failed"
      ],
      "title": "ReviewKind",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Exact source location reference in an ingested document.",
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "file_sha256": {
          "title": "File Sha256",
          "type": "string"
        },
        "unit_id": {
          "title": "Unit Id",
          "type": "string"
        },
        "unit_kind": {
          "$ref": "#/$defs/UnitKind"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "row": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "text_origin": {
          "$ref": "#/$defs/Origin"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "quote_status": {
          "$ref": "#/$defs/QuoteStatus"
        },
        "occurrence_count": {
          "default": 1,
          "title": "Occurrence Count",
          "type": "integer"
        }
      },
      "required": [
        "doc_id",
        "file_name",
        "file_sha256",
        "unit_id",
        "unit_kind",
        "text_origin",
        "quote",
        "quote_status"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "UnitKind": {
      "description": "Type of reference unit in evidence documents.",
      "enum": [
        "page",
        "line",
        "row",
        "field"
      ],
      "title": "UnitKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Directed relationship between two mentions.",
  "properties": {
    "rel_id": {
      "title": "Rel Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/RelType"
    },
    "subject_mention_id": {
      "title": "Subject Mention Id",
      "type": "string"
    },
    "object_mention_id": {
      "title": "Object Mention Id",
      "type": "string"
    },
    "assertion": {
      "$ref": "#/$defs/Assertion"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "review_flags": {
      "items": {
        "$ref": "#/$defs/ReviewKind"
      },
      "title": "Review Flags",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    }
  },
  "required": [
    "rel_id",
    "case_id",
    "type",
    "subject_mention_id",
    "object_mention_id",
    "assertion",
    "origin",
    "source"
  ],
  "title": "Relationship",
  "type": "object"
}