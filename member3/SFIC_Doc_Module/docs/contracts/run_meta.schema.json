{
  "additionalProperties": false,
  "description": "Metadata for an execution run across pipeline stages.",
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "temperature": {
      "default": 0.0,
      "title": "Temperature",
      "type": "number"
    },
    "ocr_engine": {
      "title": "Ocr Engine",
      "type": "string"
    },
    "ocr_version": {
      "title": "Ocr Version",
      "type": "string"
    },
    "ocr_langs": {
      "items": {
        "type": "string"
      },
      "title": "Ocr Langs",
      "type": "array"
    },
    "normalization_version": {
      "title": "Normalization Version",
      "type": "string"
    },
    "resolver_version": {
      "title": "Resolver Version",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "pipeline_version",
    "prompt_version",
    "provider",
    "model",
    "ocr_engine",
    "ocr_version",
    "normalization_version",
    "resolver_version",
    "idempotency_key"
  ],
  "title": "RunMeta",
  "type": "object"
}