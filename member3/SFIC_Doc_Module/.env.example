# Provider: mock (scripted, no API calls) | groq | openai | gemini.
# LLM_MODEL is required for every live provider: model names are never defaulted in code.
LLM_PROVIDER=mock
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_BASE_URL=
# Example live setup (Groq):
#   LLM_PROVIDER=groq
#   LLM_MODEL=openai/gpt-oss-120b
#   GROQ_API_KEY=<your key>
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   LLM_PROVIDERS_ENABLED=groq
# Comma-separated allow-list of providers the dev UI (`python -m atlas ui`) offers.
# Empty = offer every provider that has configured credentials.
LLM_PROVIDERS_ENABLED=
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
LLM_MAX_ATTEMPTS=3
LLM_CHUNK_CHARS=12000
MAX_LLM_CALLS_PER_RUN=40
LLM_MAX_REQUESTS_PER_MINUTE=30
LLM_RATE_WINDOW_S=60.0
LLM_MIN_INTERVAL_S=0.0
ENTITY_FILTER_CONFIG=
OCR_ENGINE=tesseract
OCR_LANGS=eng
OCR_DPI=300
OCR_PSM=3
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSDATA_PREFIX=
ATLAS_REQUIRE_TESSERACT=true
OCR_ID_AUTOTRUST_MIN_CONF=
PDF_TEXT_MIN_CHARS=25
MAX_FILE_MB=50
MAX_PDF_PAGES=60
MAX_IMAGE_PIXELS=60000000
XLSX_FULL_LOAD_MB=15
DEFAULT_PHONE_REGION=IN
DATA_DIR=./data
OUTPUT_DIR=./outputs
ATLAS_SYNTHETIC_ONLY=true
DEV2_BASE_URL=
DEV2_TOKEN=
